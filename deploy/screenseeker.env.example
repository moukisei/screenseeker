# ScreenSeeker environment file.
#
# Copy to /etc/screenseeker.env, fill it in, and lock it down:
#   sudo install -m 600 -o root -g root deploy/screenseeker.env.example /etc/screenseeker.env
#   sudo "$EDITOR" /etc/screenseeker.env
#
# Every value here is read once at process start (see settings.py). Change one,
# restart the service.

# --- Authentication --------------------------------------------------------
# Set this and the whole app requires a login. Leave it empty and the app is
# open - which is the right choice behind a tailnet (see the Tailscale section
# of deploy/README.md), and wrong on the public internet.
SCREENSEEKER_PASSWORD=change-me

# Optional. Signs the session cookie. If unset it is derived from the password,
# so setting it is only worth it to survive a password change without logging
# every device out. Generate one with: openssl rand -hex 32
# SCREENSEEKER_SECRET_KEY=

# The cookie carries Secure, so it only travels over HTTPS. Keep it true behind
# the TLS proxy. The only reason to set it false is testing auth over plain
# http on localhost.
SCREENSEEKER_COOKIE_SECURE=true

# --- TMDB ------------------------------------------------------------------
# Supplying the key here keeps it out of config.toml on disk. It overrides any
# key saved through the profile form, and the form shows the field as locked.
TMDB_API_KEY=your-tmdb-key

# --- Storage ---------------------------------------------------------------
# Persistent storage, not /tmp and not the checkout. The systemd unit grants
# write access to exactly this directory.
SCREENSEEKER_DB_PATH=/var/lib/screenseeker/screenseeker.db

# --- Server ----------------------------------------------------------------
# The OpenAPI docs map every route; keep them off in production.
SCREENSEEKER_DEBUG=false
