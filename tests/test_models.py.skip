"""
Tests for Pydantic models.
"""

from datetime import datetime

import pytest

from screenseeker.models import Film, ScrapingResult
from screenseeker.enrichers.enrichment_models import StreamingOffer


class TestFilm:
    """Tests for Film model."""

    def test_creates_film_with_required_fields(self):
        """Test creating a film with only required fields."""
        film = Film(film_title="Test Movie", year=2020)

        assert film.film_title == "Test Movie"
        assert film.year == 2020

    def test_creates_film_with_all_fields(self):
        """Test creating a film with all fields."""
        film = Film(
            film_title="Complete Movie",
            year=2021,
            letterboxd_url="https://letterboxd.com/film/complete-movie/",
            directors=["Director One", "Director Two"],
            rating=4.5,
        )

        assert film.film_title == "Complete Movie"
        assert film.year == 2021
        assert film.letterboxd_url == "https://letterboxd.com/film/complete-movie/"
        assert film.directors == ["Director One", "Director Two"]
        assert film.rating == 4.5

    def test_film_with_optional_fields_none(self):
        """Test that optional fields can be None."""
        film = Film(
            film_title="Minimal Movie",
            year=2022,
            letterboxd_url=None,
            directors=None,
            rating=None,
        )

        assert film.film_title == "Minimal Movie"
        assert film.year == 2022
        assert film.letterboxd_url is None
        assert film.directors is None
        assert film.rating is None

    def test_film_validation_rating(self):
        """Test that rating validation works."""
        # Valid rating
        film1 = Film(film_title="Good Movie", year=2020, rating=3.5)
        assert film1.rating == 3.5

        # Rating of 0 is valid
        film2 = Film(film_title="Bad Movie", year=2020, rating=0)
        assert film2.rating == 0


class TestStreamingOffer:
    """Tests for StreamingOffer model."""

    def test_creates_streaming_offer_with_all_fields(self):
        """Test creating a streaming offer with all fields."""
        offer = StreamingOffer(
            country_code="US",
            country_name="United States",
            provider_id=8,
            provider_name="Netflix",
            monetization_type="flatrate",
            presentation_type="hd",
            url="https://netflix.com/watch/123",
        )

        assert offer.country_code == "US"
        assert offer.country_name == "United States"
        assert offer.provider_id == 8
        assert offer.provider_name == "Netflix"
        assert offer.monetization_type == "flatrate"
        assert offer.presentation_type == "hd"
        assert offer.url == "https://netflix.com/watch/123"

    def test_creates_streaming_offer_with_optional_fields(self):
        """Test creating a streaming offer with optional fields."""
        offer = StreamingOffer(
            country_code="FR",
            country_name="France",
            provider_id=119,
            provider_name="Amazon Prime Video",
            monetization_type="flatrate",
            presentation_type=None,
            url=None,
        )

        assert offer.country_code == "FR"
        assert offer.provider_name == "Amazon Prime Video"
        assert offer.presentation_type is None
        assert offer.url is None

    def test_streaming_offer_monetization_types(self):
        """Test different monetization types."""
        flatrate = StreamingOffer(
            country_code="US",
            country_name="United States",
            provider_id=8,
            provider_name="Netflix",
            monetization_type="flatrate",
        )
        assert flatrate.monetization_type == "flatrate"

        rent = StreamingOffer(
            country_code="US",
            country_name="United States",
            provider_id=2,
            provider_name="Apple TV",
            monetization_type="rent",
        )
        assert rent.monetization_type == "rent"

        buy = StreamingOffer(
            country_code="US",
            country_name="United States",
            provider_id=2,
            provider_name="Apple TV",
            monetization_type="buy",
        )
        assert buy.monetization_type == "buy"


class TestScrapingResult:
    """Tests for ScrapingResult model."""

    def test_creates_empty_scrape_result(self):
        """Test creating an empty scrape result."""
        result = ScrapingResult(
            success=True,
            films=[],
            total_films=0,
            scrape_method="html",
            error_message=None,
        )

        assert result.success is True
        assert len(result.films) == 0
        assert result.total_films == 0
        assert result.scrape_method == "html"
        assert result.error_message is None

    def test_creates_scrape_result_with_films(self):
        """Test creating a scrape result with films."""
        films = [
            Film(film_title="Movie 1", year=2020),
            Film(film_title="Movie 2", year=2021),
            Film(film_title="Movie 3", year=2022),
        ]

        result = ScrapingResult(
            success=True,
            films=films,
            total_films=3,
            scrape_method="csv",
            error_message=None,
        )

        assert result.success is True
        assert len(result.films) == 3
        assert result.total_films == 3
        assert result.scrape_method == "csv"
        assert result.films[0].film_title == "Movie 1"
        assert result.films[1].film_title == "Movie 2"
        assert result.films[2].film_title == "Movie 3"

    def test_creates_failed_scrape_result(self):
        """Test creating a failed scrape result."""
        result = ScrapingResult(
            success=False,
            films=[],
            total_films=0,
            scrape_method="html",
            error_message="Connection timeout",
        )

        assert result.success is False
        assert len(result.films) == 0
        assert result.error_message == "Connection timeout"

    def test_scrape_result_with_different_methods(self):
        """Test scrape results from different methods."""
        html_result = ScrapingResult(
            success=True, films=[], total_films=0, scrape_method="html", error_message=None
        )
        assert html_result.scrape_method == "html"

        csv_result = ScrapingResult(
            success=True, films=[], total_films=0, scrape_method="csv", error_message=None
        )
        assert csv_result.scrape_method == "csv"

    def test_scrape_result_total_films_mismatch(self):
        """Test scrape result where total_films doesn't match films list."""
        # This tests that the model allows mismatches (e.g., pagination)
        films = [
            Film(film_title="Movie 1", year=2020),
            Film(film_title="Movie 2", year=2021),
        ]

        result = ScrapingResult(
            success=True,
            films=films,
            total_films=100,  # Total on website, but only scraped 2
            scrape_method="html",
            error_message=None,
        )

        assert len(result.films) == 2
        assert result.total_films == 100
