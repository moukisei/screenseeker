"""
Tests for watch strategy analyzer.
"""

import pytest

from screenseeker.enrichers.enrichment_models import StreamingOffer
from screenseeker.enrichers.watch_strategy import (
    WatchOption,
    WatchStrategy,
    WatchStrategyAnalyzer,
)


class TestWatchStrategyAnalyzer:
    """Tests for WatchStrategyAnalyzer."""

    def test_finds_best_option_with_subscriptions(self):
        """Test finding best option when user has subscriptions."""
        offers = [
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=9,
                provider_name="Amazon Prime Video",
                offer_type="flatrate",
                streaming_url="https://amazon.com/watch/123",
            ),
        ]

        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=["Netflix"],
            vpn_countries=[],
        )

        strategy = analyzer.analyze(offers)

        assert strategy.best_option is not None
        assert strategy.best_option.provider_name == "Netflix"
        assert strategy.best_option.country_code == "US"
        assert strategy.best_option.needs_vpn is False

    def test_finds_vpn_options(self):
        """Test finding VPN options when not available in user country."""
        offers = [
            StreamingOffer(
                country_code="FR",
                country_name="France",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
            StreamingOffer(
                country_code="GB",
                country_name="United Kingdom",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
        ]

        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=["Netflix"],
            vpn_countries=["FR", "GB"],
        )

        strategy = analyzer.analyze(offers)

        assert len(strategy.vpn_options) == 2
        assert all(opt.needs_vpn for opt in strategy.vpn_options)
        assert any(opt.country_code == "FR" for opt in strategy.vpn_options)
        assert any(opt.country_code == "GB" for opt in strategy.vpn_options)

    def test_finds_rent_buy_options(self):
        """Test finding rent and buy options."""
        offers = [
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=2,
                provider_name="Apple TV",
                offer_type="rent",
                streaming_url="https://tv.apple.com/rent/123",
            ),
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=2,
                provider_name="Apple TV",
                offer_type="buy",
                streaming_url="https://tv.apple.com/buy/123",
            ),
        ]

        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=[],
            vpn_countries=[],
        )

        strategy = analyzer.analyze(offers)

        assert len(strategy.rent_buy_options) == 2
        assert any(opt.offer_type == "rent" for opt in strategy.rent_buy_options)
        assert any(opt.offer_type == "buy" for opt in strategy.rent_buy_options)

    def test_no_options_available(self):
        """Test when no options are available."""
        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=["Netflix"],
            vpn_countries=[],
        )

        strategy = analyzer.analyze([])

        assert strategy.best_option is None
        assert len(strategy.vpn_options) == 0
        assert len(strategy.rent_buy_options) == 0
        assert len(strategy.all_countries) == 0
        assert len(strategy.all_providers) == 0

    def test_global_availability_summary(self):
        """Test global availability summary."""
        offers = [
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
            StreamingOffer(
                country_code="FR",
                country_name="France",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=119,
                provider_name="Amazon Prime Video",
                offer_type="flatrate",
                streaming_url="https://amazon.com/watch/123",
            ),
        ]

        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=[],
            vpn_countries=[],
        )

        strategy = analyzer.analyze(offers)

        assert len(strategy.all_countries) == 2
        assert "US" in strategy.all_countries
        assert "FR" in strategy.all_countries

        assert len(strategy.all_providers) == 2
        assert "Netflix" in strategy.all_providers
        assert "Amazon Prime Video" in strategy.all_providers

    def test_prioritizes_flatrate_over_other_types(self):
        """Test that flatrate subscriptions are prioritized."""
        offers = [
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=2,
                provider_name="Apple TV",
                offer_type="rent",
                streaming_url="https://tv.apple.com/rent/123",
            ),
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
        ]

        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=["Netflix"],
            vpn_countries=[],
        )

        strategy = analyzer.analyze(offers)

        # Best option should be Netflix (flatrate), not Apple TV (rent)
        assert strategy.best_option is not None
        assert strategy.best_option.provider_name == "Netflix"
        assert strategy.best_option.offer_type == "flatrate"

    def test_handles_multiple_offers_same_provider(self):
        """Test handling multiple offers from the same provider."""
        offers = [
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/456",  # Duplicate
            ),
        ]

        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=["Netflix"],
            vpn_countries=[],
        )

        strategy = analyzer.analyze(offers)

        assert strategy.best_option is not None
        # Should handle duplicates gracefully

    def test_case_insensitive_subscription_matching(self):
        """Test that subscription matching is case-insensitive."""
        offers = [
            StreamingOffer(
                country_code="US",
                country_name="United States",
                provider_id=8,
                provider_name="Netflix",
                offer_type="flatrate",
                streaming_url="https://netflix.com/watch/123",
            ),
        ]

        # User has "netflix" (lowercase) in subscriptions
        analyzer = WatchStrategyAnalyzer(
            user_country="US",
            subscriptions=["netflix"],  # lowercase
            vpn_countries=[],
        )

        strategy = analyzer.analyze(offers)

        # Should still match "Netflix" (title case)
        assert strategy.best_option is not None
        assert strategy.best_option.provider_name == "Netflix"


class TestWatchOption:
    """Tests for WatchOption model."""

    def test_creates_watch_option(self):
        """Test creating a WatchOption."""
        option = WatchOption(
            country_code="US",
            country_name="United States",
            provider_id=8,
            provider_name="Netflix",
            offer_type="flatrate",
            streaming_url="https://netflix.com/watch/123",
            needs_vpn=False,
        )

        assert option.country_code == "US"
        assert option.provider_name == "Netflix"
        assert option.offer_type == "flatrate"
        assert option.needs_vpn is False


class TestWatchStrategy:
    """Tests for WatchStrategy model."""

    def test_creates_watch_strategy(self):
        """Test creating a WatchStrategy."""
        best = WatchOption(
            country_code="US",
            country_name="United States",
            provider_id=8,
            provider_name="Netflix",
            offer_type="flatrate",
            streaming_url="https://netflix.com/watch/123",
            needs_vpn=False,
        )

        strategy = WatchStrategy(
            best_option=best,
            vpn_options=[],
            rent_buy_options=[],
            all_countries=["US", "FR"],
            all_providers=["Netflix", "Amazon Prime Video"],
        )

        assert strategy.best_option.provider_name == "Netflix"
        assert len(strategy.all_countries) == 2
        assert len(strategy.all_providers) == 2

    def test_creates_strategy_without_best_option(self):
        """Test creating a strategy when no best option available."""
        strategy = WatchStrategy(
            best_option=None,
            vpn_options=[],
            rent_buy_options=[],
            all_countries=[],
            all_providers=[],
        )

        assert strategy.best_option is None
        assert len(strategy.vpn_options) == 0
