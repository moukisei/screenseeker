# ScreenSeeker Environment Configuration
# Copy this file to .env and fill in your actual values

# TMDB API Configuration (Required)
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Letterboxd Configuration
LETTERBOXD_USERNAME=your_letterboxd_username

# Optional: CSV file path for CSV scraping
# CSV_FILE_PATH=/path/to/your/watchlist.csv

# Optional: Logging configuration
# LOG_LEVEL=INFO
# LOG_TO_FILE=False
